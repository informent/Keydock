{
  "name": "keydock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-source licensing infrastructure for software owners.",
  "license": "MIT",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "test": "node --test --test-isolation=none --test-concurrency=1 tests/*.test.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:ui": "node scripts/ui-smoke.mjs && node scripts/ui-experience-smoke.mjs && node scripts/ui-customers-smoke.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "backup": "node scripts/backup.mjs create",
    "backup:verify": "node scripts/backup.mjs verify",
    "restore": "node scripts/backup.mjs restore",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.0",
    "lucide-react": "^0.577.0",
    "prettier": "^3.9.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
